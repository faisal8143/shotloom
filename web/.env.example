# Optional. Leave both empty and every visitor pastes their own fal.ai key in Settings (BYOK).
#
# Set FAL_KEY to make the deployment use YOUR key for everyone who knows the studio password.
# SHOTLOOM_PASSWORD is then required - without it the server key is never used,
# so a public URL can't burn your credits.
FAL_KEY=
SHOTLOOM_PASSWORD=

# Optional. Points the free (Hugging Face Space) path at a stand-in server;
# used by tests/mock-space.mjs. Leave empty in production.
SHOTLOOM_HF_BASE=
NEXT_PUBLIC_SHOTLOOM_HF_BASE=
