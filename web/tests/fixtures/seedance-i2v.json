    }
   }
  },
  "/bytedance/seedance-2.0/image-to-video/requests/{request_id}/cancel": {
   "put": {
    "responses": {
     "200": {}
    }
   }
  },
  "/bytedance/seedance-2.0/image-to-video": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SeedanceV2ImageToVideoInput"
       }
      }
     }
    },
    "responses": {
     "200": {}
    }
   }
  },
  "/bytedance/seedance-2.0/image-to-video/requests/{request_id}": {
   "get": {
    "responses": {
     "200": {}
    }
   }
  }
 }
}