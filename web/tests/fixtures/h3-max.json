{
 "openapi": "3.0.4",
 "info": {
  "title": "minimax/h3-max/text-to-video",
  "version": "1"
 },
 "components": {
  "schemas": {
   "H3MaxInput": {
    "type": "object",
    "properties": {
     "prompt": {
      "type": "string"
     },
     "prompt_expansion_mode": {
      "type": "string",
      "default": "balanced"
     },
     "duration": {
      "type": "number",
      "default": 5,
      "minimum": 0.92,
      "maximum": 15
     },
     "resolution": {
      "enum": [
       "480P",
       "768P",
       "1080P"
      ],
      "type": "string",
      "default": "768P"
     },
     "aspect_ratio": {
      "enum": [
       "21:9",
       "16:9",
       "4:3",
       "1:1",
       "3:4",
       "9:16"
      ],
      "type": "string",
      "default": "16:9"
     },
     "seed": {
      "type": "integer"
     }
    },
    "required": [
     "prompt",
     "prompt_expansion_mode"
    ]
   },
   "ImageSize": {
    "type": "object",
    "properties": {
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     }
    }
   }
  }
 },
 "paths": {
  "/minimax/h3-max/text-to-video": {
   "post": {
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/H3MaxInput"
       }
      }
     }
    }
   }
  },
  "/minimax/h3-max/text-to-video/requests/{request_id}": {
   "get": {}
  }
 }
}